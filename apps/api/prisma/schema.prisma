generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One slide in the homepage hero carousel, managed from /admin.
/// The file itself lives in S3; this row is metadata plus the object key.
model HeroImage {
  id String @id @default(uuid())

  /// S3 object key, e.g. "hero/6f1c….webp". Unique so a replayed commit can't
  /// register the same object twice.
  storageKey String @unique

  /// Alt text. Empty string is valid and means "decorative".
  alt String @default("")

  /// Ascending display order. Gaps are fine — the list is sorted, not indexed by this.
  sortOrder Int @default(0)

  /// Intrinsic pixel dimensions, read client-side at upload. Nullable because a
  /// commit may arrive without them; the carousel falls back to a fixed box.
  width  Int?
  height Int?

  sizeBytes Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// A menu column on the site header/footer: "Chroma", "Calibration", "Standard Compliance".
/// The menu is derived from published pages grouped by this — there is no second list.
model NavGroup {
  id        String @id @default(cuid())
  /// products | services | solutions
  section   String
  title     String
  sortOrder Int    @default(0)
  pages     Page[]

  @@unique([section, title])
}

/// One page under /<section>/<slug>, authored in the admin (or imported as JSON).
/// Top-level pages carry a `groupId` and appear in the menu; child pages (a product under
/// a category) carry a `parentId` and are reachable by link only.
model Page {
  id       String    @id @default(cuid())
  /// products | services | solutions
  section  String
  slug     String
  title    String
  /// Menu text when shorter than the title.
  navLabel String?
  groupId  String?
  group    NavGroup? @relation(fields: [groupId], references: [id])
  parentId String?
  parent   Page?     @relation("PageTree", fields: [parentId], references: [id])
  children Page[]    @relation("PageTree")
  /// For a child page: the product group (category tab) it appears under on its parent page.
  productGroup String?

  sortOrder Int     @default(0)
  showInNav Boolean @default(true)
  /// draft | published
  status    String  @default("draft")

  /// Puck documents: `{ root, content: [{ type, props }] }`. Editing touches only
  /// `draftData`; Publish copies it to `publishedData`, which is all the site reads.
  draftData     Json?
  publishedData Json?

  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([section, slug])
  @@index([section, status])
  @@index([parentId])
  @@index([groupId])
}
