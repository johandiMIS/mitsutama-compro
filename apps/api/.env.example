# Copy to .env and fill in. .env is gitignored; this file is not.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mitsutama_compro?schema=public"
PORT=3007

# Origin allowed to send credentialed requests (the admin session cookie).
WEB_ORIGIN="http://localhost:3006"

# Number of reverse-proxy hops in front of the API (usually 1 when deployed behind
# nginx / a load balancer). Needed so the admin login rate limit sees real client IPs.
# Leave empty when the API is exposed directly, or clients can spoof X-Forwarded-For.
TRUST_PROXY=""

# --- Admin panel (/admin in apps/web) -------------------------------------
# Interim single-password auth. Both must be set or the panel fails closed and
# nothing authenticates. Replace with the real auth module later — see
# docs/auth-passportjs-google.md.
ADMIN_PASSWORD="change-me"
# Signs the session cookie. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_TTL_HOURS=12

# --- S3 (hero image storage) ----------------------------------------------
AWS_REGION="ap-southeast-1"
S3_BUCKET=""
# Optional. Omit to use the SDK's own credential chain (instance role / shared
# config), which is what a deployed host should do.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional CDN/CloudFront origin serving the bucket. When set, public URLs are
# built from this instead of the default bucket URL. No trailing slash.
S3_PUBLIC_BASE_URL=""

# Optional canned ACL applied to uploads, e.g. "public-read". LEAVE EMPTY for
# buckets with Object Ownership = "Bucket owner enforced" (the default for
# buckets created since April 2023) — ACLs are disabled there and sending one
# makes S3 reject the upload. Grant public read with a bucket policy instead.
S3_UPLOAD_ACL=""

# --- Content pages: cache invalidation ---------------------------------------
# After publish/unpublish the API calls POST {WEB_URL}/api/revalidate so the live
# page and menu update immediately. REVALIDATE_SECRET must match apps/web's. If either
# is unset, changes still appear — after the web cache expires (a few minutes).
# No quotes around values.
WEB_URL=http://localhost:3006
REVALIDATE_SECRET=
