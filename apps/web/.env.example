# Copy to .env.local and adjust. .env* is gitignored; this file is not.

# Base URL of apps/api. Used by the admin panel at /admin.
NEXT_PUBLIC_API_URL="http://localhost:3007"

# Bare hostname serving the uploaded hero images, allowlisted for next/image.
# Either the bucket's own host or a CDN alias in front of it — must match whatever
# apps/api builds public URLs from (S3_BUCKET/AWS_REGION, or S3_PUBLIC_BASE_URL).
#   e.g. mitsutama-compro.s3.ap-southeast-1.amazonaws.com
#   e.g. cdn.mitsutama.co.id
NEXT_PUBLIC_IMAGE_HOST=""

# Must match apps/api REVALIDATE_SECRET (the API calls /api/revalidate with it after publish).
# Fails closed: unset = the revalidate endpoint rejects everything. No quotes around the value.
REVALIDATE_SECRET=
