# Copy to scripts/push-content.env (gitignored). No quotes needed.
# SSH target for the VPS (key auth; the Windows OpenSSH client must work non-interactively).
DEPLOY_SSH=ubuntu@your-vps-host
# Repo path on the server; its apps/api/.env supplies the production DATABASE_URL.
REMOTE_APP_ROOT=/var/www/compro
# Public web origin + the secret from apps/web's REVALIDATE_SECRET (optional; without them
# the live site refreshes on its own within a few minutes).
WEB_URL=https://your-domain.example
REVALIDATE_SECRET=
# Optional: private key file to use (OpenSSH format, NOT .ppk). Needed when the default
# ~/.ssh/id_ed25519 isn't the one the server has authorized.
# DEPLOY_SSH_KEY=C:/Users/you/.ssh/id_ed25519
